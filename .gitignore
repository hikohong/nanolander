# macOS writes these into any directory it looks at, so a Mac user who opens
# the repository in Finder — or just runs the installer from it — ends up with
# them alongside the scripts. They are metadata about the folder, never
# content, and none of them belong in a clone.
#
# Patterns without a leading slash match at every depth, which is what is
# wanted here: Finder drops .DS_Store into subdirectories too.
.DS_Store
.AppleDouble
.LSOverride

# Resource forks, written when a file is copied to a filesystem that has no
# native place for them. Every ._foo shadows a real foo.
._*

# Files a mounted volume gets, including one shared over the network.
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.apdisk

# A folder with a custom Finder icon carries a file literally named "Icon"
# followed by a carriage return. The Icon[\r] spelling copied around for this
# matches nothing — git does not read \r as an escape there — and Icon? also
# swallows any real Icons or Icon.png. A control-character class is the one
# form that hits the CR and leaves ordinary names alone.
Icon[[:cntrl:]]

# Directories an AFP or SMB share leaves behind.
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items

# ---------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------

# Explorer's thumbnail caches, written into any folder it renders as icons.
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Per-folder Explorer settings. Capitalised either way depending on how the
# folder was created.
[Dd]esktop.ini

# The recycle bin a file share gets.
$RECYCLE.BIN/

# Crash dumps from the POSIX subsystem, which is what Git Bash and Cygwin run
# under, so a crashed script here leaves one.
*.stackdump

# Shortcuts. Explorer offers to make one whenever a file is dragged.
*.lnk

# Deliberately not here: *.msi, *.cab, *.msix, *.msm, *.msp. Those are
# distributable installers, not something Windows drops in a working
# directory, and this project ships none — the pattern could only ever hide a
# mistake.

# ---------------------------------------------------------------------------
# Linux
# ---------------------------------------------------------------------------

# Backup copies, written by most editors and by sed -i.bak style workflows.
# The restore instructions in README.md produce these.
*~

# Left behind when a process still holds a deleted file open on a FUSE mount.
.fuse_hidden*

# Per-folder settings, the KDE counterpart to desktop.ini.
.directory

# The trash folder a partition or removable disk gets.
.Trash-*

# Written when an open file is removed on an NFS mount and the handle is still
# live. An EC2 instance with a shared home directory produces these.
.nfs*

# Not ignored on purpose: share/nvim/lazy-lock.json is shipped, because it is
# what pins the plugin set. Regenerate it with ./bin/nvim-land --freeze and
# commit the result.
