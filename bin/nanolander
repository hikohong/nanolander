#!/usr/bin/env bash
#
# nanolander — land on any machine with the whole kit.
#
# One script that installs the same modern terminal toolchain on macOS,
# Ubuntu, Amazon Linux 2 and Amazon Linux 2023, then wires up the shell.
# Distribution packages first; official GitHub releases when the repository
# does not carry the tool.
#
# Written for bash 3.2 — the version macOS still ships — so there are no
# associative arrays, no mapfile and no ${var,,} anywhere in this file.
#
# Docs: README.md / docs/index.html
# License: MIT (see LICENSE)

set -uo pipefail

readonly NANOLANDER_VERSION="1.0.0"

# ---------------------------------------------------------------------------
# Exit codes (documented in README.md, "Logs and exit codes")
# ---------------------------------------------------------------------------
readonly EXIT_OK=0        # everything requested installed and verified
readonly EXIT_ENV=1       # environment prep failed (unknown OS, repo refresh)
readonly EXIT_PARTIAL=2   # some tools failed to install or verify
readonly EXIT_USAGE=64    # bad arguments
readonly EXIT_INTERRUPT=130

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
LOCAL_BIN="$HOME/.local/bin"
LOCAL_OPT="$HOME/.local/opt"
LOG_FILE="$HOME/nanolander-$(date +%Y%m%d-%H%M%S).log"

# Shell config files are copied here before the first write of a run, so a
# run is always undoable. Shared with bin/iterm-tune.
BACKUP_DIR="$HOME/.nanolander-backups"

# Everything installed into ~/.local by this script is recorded here, so
# --uninstall removes exactly what nanolander put there and nothing else.
STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/nanolander"
MANIFEST="$STATE_DIR/installed"

# The patched font that supplies the glyphs Starship and eza icons draw with.
# Deliberately fetched from the upstream release on every platform rather than
# from brew/apt/dnf/yum, so all four end up with the identical font files.
NERD_FONT_FAMILY="${NANOLANDER_NERD_FONT:-JetBrainsMono}"
NERD_FONT_REPO="ryanoasis/nerd-fonts"

# ---------------------------------------------------------------------------
# Tool catalog — the single source of truth for --list-tools and the install
# loop. One record per line: command|display name|category|purpose
#
# Adding a tool means adding a line here plus, where needed, an entry in
# pkg_candidates() and github_repo().
# ---------------------------------------------------------------------------
TOOL_CATALOG='btop|btop|System & resource monitoring|Graphical resource monitor with live CPU, memory, disk and network curves
htop|htop|System & resource monitoring|Classic interactive process viewer for sorting and signalling processes
btm|bottom|System & resource monitoring|Configurable monitor, lighter than btop on small or remote machines
fastfetch|fastfetch|System & resource monitoring|Fast system summary (OS, kernel, CPU, memory) when landing on a host
lazygit|lazygit|Git & development flow|Terminal UI for git: stage hunks, interactive rebase, browse history
tig|tig|Git & development flow|ncurses git browser for log, blame and per-line changes
delta|git-delta|Git & development flow|Pager for git diff with syntax highlighting and line numbers
difft|difftastic|Git & development flow|Structural diff that compares syntax trees instead of text lines
gh|GitHub CLI|Git & development flow|Drive GitHub from the terminal: PRs, issues, releases, actions
git|Git|Git & development flow|Version control itself, installed and version-checked on all four platforms
ctags|universal-ctags|Code navigation & quality|Tag index so Vim/Neovim can jump straight to a definition
cscope|cscope|Code navigation & quality|C/C++ cross-reference browser for symbols, callers and callees
tree-sitter|tree-sitter CLI|Code navigation & quality|Grammar compiler the Neovim treesitter layer needs to build parsers
shellcheck|ShellCheck|Code navigation & quality|Static analysis for shell scripts
shfmt|shfmt|Code navigation & quality|Formatter for sh/bash scripts
just|just|Project workflow|Command runner with recipes simpler than a Makefile
entr|entr|Project workflow|Re-run a command whenever the watched files change
direnv|direnv|Project workflow|Load and unload environment variables per directory
lazydocker|lazydocker|Containers|Terminal UI for Docker containers, images, volumes and live logs
dive|dive|Containers|Inspect a Docker image layer by layer to find wasted space
nvim|Neovim|Terminal environment|Modern Vim fork with Lua config and LSP, used as the default editor
neovide|Neovide|Terminal environment|GUI Neovim client; desktop machines only, see --list-tools notes
tmux|tmux|Terminal environment|Terminal multiplexer; sessions survive an SSH drop
starship|Starship|Terminal environment|Fast cross-shell prompt with git state, language versions and timing
zoxide|zoxide|Terminal environment|Frecency-ranked cd replacement
nerd-font|Nerd Font|Terminal environment|Patched font carrying the glyphs the Starship prompt and eza icons need
yazi|yazi|File browsing & search|Terminal file manager with async I/O and real image previews
eza|eza|File browsing & search|Modern ls with colors, icons, tree view and git status
bat|bat|File browsing & search|cat with syntax highlighting and line numbers
fd|fd|File browsing & search|Fast, friendly find replacement that respects .gitignore
rg|ripgrep|File browsing & search|Very fast recursive text search
sd|sd|File browsing & search|Intuitive find-and-replace, simpler than sed -i
fzf|fzf|File browsing & search|Fuzzy finder; wired to Ctrl-R for history and Ctrl-T for files
tree|tree|File browsing & search|Indented tree view of a directory
file|file|File preview backends|MIME detection, which is how yazi picks a previewer
ffmpeg|FFmpeg|File preview backends|Video and audio thumbnails and metadata (ffprobe comes with it)
pdftoppm|Poppler|File preview backends|Renders a PDF page to an image so it can be previewed
7zz|7-Zip|File preview backends|Reads inside an archive without unpacking it
magick|ImageMagick|File preview backends|Converts HEIC, JPEG XL and font files into something previewable
resvg|resvg|File preview backends|Renders SVG; macOS and x86_64 Linux only, see --list-tools notes
dust|dust|Disk & space|Visual du that points straight at the biggest directories
duf|duf|Disk & space|Readable df with a table and usage bars
ncdu|ncdu|Disk & space|Interactive disk usage browser that can delete in place
jq|jq|Data & documents|The standard JSON query and transform tool
yq|yq|Data & documents|jq-style processor for YAML/JSON/TOML/XML
glow|glow|Data & documents|Render Markdown nicely in the terminal
tldr|tldr|Data & documents|Community-maintained, example-first command help
xh|xh|Network & measurement|Fast HTTP client with HTTPie-like syntax
gping|gping|Network & measurement|ping with a live line graph
hyperfine|hyperfine|Network & measurement|Command-line benchmarking with warmup and statistics
wget|wget|Network & measurement|Non-interactive downloader with resume and mirroring
watch|watch|Base system tools|Repeat a command at a fixed interval and watch the output change
rsync|rsync|Base system tools|Reliable incremental file sync, locally or over SSH
unzip|unzip|Base system tools|Extract .zip archives'

# ---------------------------------------------------------------------------
# Runtime state
# ---------------------------------------------------------------------------
OS_KIND=""        # macos | ubuntu | amazon
OS_LABEL=""
PKG_MANAGER=""    # brew | apt-get | dnf | yum
SHELL_RC=""
SHELL_KIND=""     # zsh | bash
SHELL_RC_REASON="" # why that file was picked, for the report
ARCH=""           # x86_64 | arm64 | armv7 | armv6
RAW_ARCH=""
ARCH_KEYWORDS=""
OS_KEYWORDS=""
BREW_BIN=""

ONLY_LIST=""
SKIP_LIST=""
OPT_SHELL=""      # --shell bash|zsh, empty when not given
OPT_SET_DEFAULT_SHELL=0
OPT_WITH_ALIASES=0
OPT_CONFIGURE_GIT=0
OPT_WITH_NVIM_CONFIG=0

RESULTS=""        # cmd|status|source|path per line
COUNT_SUCCESS=0
COUNT_FAILED=0
COUNT_SKIPPED=0   # asked not to install: --only / --skip
COUNT_ABSENT=0    # nothing to install here: no build for this platform

INSTALL_SOURCE=""
PKG_ATTEMPTED=0   # did this tool's package install actually run and fail?
BACKED_UP=""      # files already backed up in this run
PICKED_URL=""
PICKED_DIGEST=""

# ---------------------------------------------------------------------------
# Output helpers. Deliberately plain text: the log file is a byte-for-byte
# copy of the screen, so `grep '== Installing yq =='` works on it.
# ---------------------------------------------------------------------------
info() { printf '[INFO] %s\n' "$*"; }
ok()   { printf '[ OK ] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*"; }
fail() { printf '[FAIL] %s\n' "$*"; }
section() { printf '\n== %s ==\n' "$*"; }

tool_count() { printf '%s\n' "$TOOL_CATALOG" | grep -c '|'; }

usage() {
  cat <<USAGE
nanolander ${NANOLANDER_VERSION} — land on any machine with the whole kit.

Installs $(tool_count) modern terminal tools on macOS, Ubuntu, Amazon Linux 2 and
Amazon Linux 2023, then configures the shell. Distribution packages are used
where they exist; otherwise the official GitHub release is fetched into
~/.local/bin.

USAGE:
  ./bin/nanolander [options]

OPTIONS:
  -h, --help              Show this help and exit without installing anything.
      --list-tools        List every installable tool and exit.
      --only a,b,c        Install only these tools; everything else is SKIPPED.
      --skip a,b,c        Install everything except these tools.
      --shell bash|zsh    Configure this shell instead of the one detected from
                          your login shell. Use it when you log in as one shell
                          and want the other one set up.
      --set-default-shell Switch the login shell to zsh (macOS / Amazon Linux).
      --with-aliases      Add the optional alias block to the shell rc file.
      --configure-git     Set git-delta as the global git pager.
      --with-nvim-config  Also install the Neovim configuration, by running
                          ./bin/nvim-land --apply once the tools are in.
      --restore-shell     Restore the most recent shell config backup.
      --uninstall         Remove the shell configuration and the tools this
                          script installed under ~/.local.

  Names may be either the command (rg) or the tool name (ripgrep); matching
  ignores case and surrounding whitespace. Options combine freely.

SHELL CONFIG FILE:
  The file is chosen from your login shell, because that is what decides which
  file is read: bash gets ~/.bashrc, zsh gets ~/.zshrc, and a wrapper counts
  (an Amazon cloud desktop logs you into logbash, which is bash). If the login
  shell is neither, the platform default is used. --shell overrides all of it.

EXAMPLES:
  ./bin/nanolander
  ./bin/nanolander --list-tools
  ./bin/nanolander --only nvim,tmux,fzf,ripgrep
  ./bin/nanolander --skip lazydocker,dive
  ./bin/nanolander --shell zsh
  ./bin/nanolander --set-default-shell --with-aliases --configure-git
  ./bin/nanolander --with-nvim-config
  ./bin/nanolander --restore-shell
  ./bin/nanolander --uninstall

ENVIRONMENT:
  GITHUB_TOKEN  Used for GitHub API calls when set, which raises the rate
                limit. Unauthenticated runs may hit 403 partway through.

EXIT CODES:
  0   every requested tool installed and verified (filtered ones count as OK)
  1   environment preparation failed
  2   one or more tools failed to install or verify
  64  bad arguments
  130 interrupted

COMPANION SCRIPTS:
  ./bin/nvim-land    Install the Neovim configuration that goes with these
                     tools (reports by default, writes with --apply).
  ./bin/iterm-tune   iTerm2 performance tuning, macOS only.

UNDOING A RUN:
  Shell config files are copied into ~/.nanolander-backups the first time a
  run modifies them, so --restore-shell can put the previous version back.
  --uninstall instead removes only the lines this script added, plus the
  paths it recorded under ~/.local; system packages are left alone.
  The Neovim configuration is undone with ./bin/nvim-land --restore.

Log: ~/nanolander-YYYYMMDD-HHMMSS.log
USAGE
}

# print_tool_catalog — backs --list-tools.
print_tool_catalog() {
  local cmd name category purpose last_category=""
  printf 'nanolander %s — %s installable tools\n' "$NANOLANDER_VERSION" "$(tool_count)"
  while IFS='|' read -r cmd name category purpose; do
    [ -n "$cmd" ] || continue
    if [ "$category" != "$last_category" ]; then
      printf '\n%s\n' "$category"
      last_category="$category"
    fi
    printf '  %-11s %-16s %s\n' "$cmd" "$name" "$purpose"
  done <<CATALOG
$TOOL_CATALOG
CATALOG
  printf '\nFilter with --only or --skip using either column, e.g. --only rg,ripgrep\n'
  printf 'Every tool lands on all four platforms except three: Neovide and resvg are\n'
  printf 'published for macOS and x86_64 Linux only, and yazi has no 32-bit ARM build\n'
  printf 'anywhere. Where there is nothing to fetch the tool is SKIPPED, not FAILED.\n'
  printf 'The preview backends exist for yazi; each is useful on its own too.\n'
  printf 'Neovim configuration is a separate step: ./bin/nvim-land\n'
}

# ---------------------------------------------------------------------------
# Argument parsing — every option may be combined with every other one.
# ---------------------------------------------------------------------------
DO_HELP=0
DO_LIST=0
DO_RESTORE_SHELL=0
DO_UNINSTALL=0

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) DO_HELP=1 ;;
      --list-tools) DO_LIST=1 ;;
      --restore-shell) DO_RESTORE_SHELL=1 ;;
      --uninstall) DO_UNINSTALL=1 ;;
      --only)
        [ $# -ge 2 ] || { fail "--only needs a comma separated list."; return "$EXIT_USAGE"; }
        ONLY_LIST="$2"; shift ;;
      --only=*) ONLY_LIST="${1#--only=}" ;;
      --skip)
        [ $# -ge 2 ] || { fail "--skip needs a comma separated list."; return "$EXIT_USAGE"; }
        SKIP_LIST="$2"; shift ;;
      --skip=*) SKIP_LIST="${1#--skip=}" ;;
      --shell)
        [ $# -ge 2 ] || { fail "--shell needs bash or zsh."; return "$EXIT_USAGE"; }
        OPT_SHELL="$2"; shift ;;
      --shell=*) OPT_SHELL="${1#--shell=}" ;;
      --set-default-shell) OPT_SET_DEFAULT_SHELL=1 ;;
      --with-aliases) OPT_WITH_ALIASES=1 ;;
      --configure-git) OPT_CONFIGURE_GIT=1 ;;
      --with-nvim-config) OPT_WITH_NVIM_CONFIG=1 ;;
      --version) printf 'nanolander %s\n' "$NANOLANDER_VERSION"; exit "$EXIT_OK" ;;
      --) shift; break ;;
      *)
        fail "Unknown option: $1"
        printf 'Try ./bin/nanolander --help\n'
        return "$EXIT_USAGE" ;;
    esac
    shift
  done
  if [ -n "$ONLY_LIST" ] && [ -n "$SKIP_LIST" ]; then
    fail "--only and --skip cannot be used together."
    return "$EXIT_USAGE"
  fi
  if [ -n "$OPT_SHELL" ]; then
    OPT_SHELL=$(normalise "$OPT_SHELL")
    case "$OPT_SHELL" in
      bash|zsh) ;;
      *)
        fail "--shell takes bash or zsh, not: $OPT_SHELL"
        return "$EXIT_USAGE" ;;
    esac
  fi
  # --shell says which rc file to write; --set-default-shell would then switch
  # the login shell to zsh underneath it. Asking for both in opposite
  # directions configures a file the new login shell will not read.
  if [ "$OPT_SHELL" = "bash" ] && [ "$OPT_SET_DEFAULT_SHELL" -eq 1 ]; then
    fail "--shell bash and --set-default-shell contradict each other."
    info "--set-default-shell makes zsh your login shell, which reads ~/.zshrc."
    return "$EXIT_USAGE"
  fi
  if [ "$DO_RESTORE_SHELL" -eq 1 ] && [ "$DO_UNINSTALL" -eq 1 ]; then
    fail "--restore-shell and --uninstall cannot be used together."
    return "$EXIT_USAGE"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# wants_tool — the --only / --skip filter. Case and whitespace insensitive;
# either the command name or the display name matches. Filtered tools are
# reported as SKIPPED and never count as a failure.
# ---------------------------------------------------------------------------
normalise() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]'; }

list_contains() {
  local list="$1" cmd="$2" name="$3" item old_ifs
  old_ifs="$IFS"
  IFS=','
  # Word splitting on commas is the point here.
  # shellcheck disable=SC2086
  set -- $list
  IFS="$old_ifs"
  for item in "$@"; do
    item=$(normalise "$item")
    [ -n "$item" ] || continue
    if [ "$item" = "$cmd" ] || [ "$item" = "$name" ]; then
      return 0
    fi
  done
  return 1
}

wants_tool() {
  local cmd name
  cmd=$(normalise "$1")
  name=$(normalise "$2")
  if [ -n "$ONLY_LIST" ]; then
    list_contains "$ONLY_LIST" "$cmd" "$name"
    return $?
  fi
  if [ -n "$SKIP_LIST" ]; then
    if list_contains "$SKIP_LIST" "$cmd" "$name"; then
      return 1
    fi
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Environment detection — uname -s plus /etc/os-release decide the package
# manager and the shell rc target; uname -m is normalised into the keyword
# set used later to pick a GitHub release asset.
#
# SHELL_RC/SHELL_KIND are set per platform here only as a fallback;
# resolve_shell_rc below has the last word, because the login shell decides
# which file is actually read.
# ---------------------------------------------------------------------------
detect_environment() {
  section "Detected environment"

  case "$(uname -s)" in
    Darwin)
      OS_KIND="macos"
      OS_LABEL="macOS $(sw_vers -productVersion 2>/dev/null || printf 'unknown')"
      PKG_MANAGER="brew"
      SHELL_RC="$HOME/.zshrc"
      SHELL_KIND="zsh"
      ;;
    Linux)
      local id="" id_like="" pretty="" version_id=""
      if [ -r /etc/os-release ]; then
        id=$(sed -n 's/^ID=//p' /etc/os-release | tr -d '"' | head -1)
        id_like=$(sed -n 's/^ID_LIKE=//p' /etc/os-release | tr -d '"' | head -1)
        pretty=$(sed -n 's/^PRETTY_NAME=//p' /etc/os-release | tr -d '"' | head -1)
        version_id=$(sed -n 's/^VERSION_ID=//p' /etc/os-release | tr -d '"' | head -1)
      fi
      case "$id" in
        ubuntu|debian|linuxmint|pop|raspbian)
          OS_KIND="ubuntu"
          OS_LABEL="${pretty:-Ubuntu}"
          PKG_MANAGER="apt-get"
          SHELL_RC="$HOME/.bashrc"
          SHELL_KIND="bash"
          ;;
        amzn)
          OS_KIND="amazon"
          OS_LABEL="${pretty:-Amazon Linux}"
          if [ "$version_id" = "2" ] || ! command -v dnf >/dev/null 2>&1; then
            PKG_MANAGER="yum"
          else
            PKG_MANAGER="dnf"
          fi
          SHELL_RC="$HOME/.zshrc"
          SHELL_KIND="zsh"
          ;;
        *)
          # Fall back to the family, so a Debian or RHEL derivative still works.
          case " $id_like " in
            *debian*)
              OS_KIND="ubuntu"; OS_LABEL="${pretty:-Debian-like}"
              PKG_MANAGER="apt-get"; SHELL_RC="$HOME/.bashrc"; SHELL_KIND="bash" ;;
            *fedora*|*rhel*|*centos*)
              OS_KIND="amazon"; OS_LABEL="${pretty:-RHEL-like}"
              if command -v dnf >/dev/null 2>&1; then PKG_MANAGER="dnf"; else PKG_MANAGER="yum"; fi
              SHELL_RC="$HOME/.zshrc"; SHELL_KIND="zsh" ;;
            *)
              fail "Unsupported Linux distribution: ${pretty:-${id:-unknown}}"
              info "nanolander supports macOS, Ubuntu, Amazon Linux 2 and Amazon Linux 2023."
              return "$EXIT_ENV" ;;
          esac
          ;;
      esac
      ;;
    *)
      fail "Unsupported operating system: $(uname -s)"
      return "$EXIT_ENV"
      ;;
  esac

  RAW_ARCH=$(uname -m)
  case "$RAW_ARCH" in
    x86_64|amd64)      ARCH="x86_64" ;;
    arm64|aarch64)     ARCH="arm64" ;;
    armv7*|armhf)      ARCH="armv7" ;;
    armv6*)            ARCH="armv6" ;;
    *)
      fail "Unsupported CPU architecture: $RAW_ARCH"
      return "$EXIT_ENV" ;;
  esac

  # Release-asset keywords, most specific first. Matching tries a full suffix
  # match on every keyword before falling back to substring containment, so
  # linux_arm never swallows linux_arm64.
  if [ "$OS_KIND" = "macos" ]; then
    OS_KEYWORDS="apple-darwin darwin macos osx"
    case "$ARCH" in
      arm64)  ARCH_KEYWORDS="aarch64-apple-darwin arm64-apple-darwin darwin_arm64 arm64 aarch64" ;;
      x86_64) ARCH_KEYWORDS="x86_64-apple-darwin darwin_amd64 x86_64 amd64 x64" ;;
    esac
  else
    OS_KEYWORDS="linux"
    case "$ARCH" in
      x86_64) ARCH_KEYWORDS="x86_64-unknown-linux-gnu x86_64-unknown-linux-musl linux_amd64 linux-amd64 x86_64 amd64 x64 64bit" ;;
      arm64)  ARCH_KEYWORDS="aarch64-unknown-linux-gnu aarch64-unknown-linux-musl linux_arm64 linux-arm64 aarch64 arm64" ;;
      armv7)  ARCH_KEYWORDS="armv7-unknown-linux-gnueabihf arm-unknown-linux-gnueabihf linux_armv7 linux-armv7 armv7l armv7 armhf" ;;
      armv6)  ARCH_KEYWORDS="arm-unknown-linux-gnueabi linux_armv6 linux-armv6 armv6l armv6" ;;
    esac
  fi

  resolve_shell_rc

  info "OS: $OS_LABEL"
  info "Architecture: $RAW_ARCH ($ARCH)"
  info "Package manager: $PKG_MANAGER"
  info "Shell config: $SHELL_RC ($SHELL_KIND) — $SHELL_RC_REASON"
  info "Local bin: $LOCAL_BIN"
  [ -n "${GITHUB_TOKEN:-}" ] && info "GITHUB_TOKEN detected; GitHub API calls will be authenticated."
  return 0
}

current_login_shell() {
  if [ "$OS_KIND" = "macos" ]; then
    dscl . -read "/Users/$(id -un)" UserShell 2>/dev/null | awk '{print $2}'
  else
    getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7
  fi
}

# shell_kind_of — which flavour of rc file does this login shell read? Matched
# on the suffix rather than the exact name, because a wrapper counts: an Amazon
# cloud desktop logs you into /usr/bin/logbash, which is bash and reads
# ~/.bashrc. Anything else — fish, tcsh, sh — gets no answer at all, so the
# caller keeps the platform default instead of guessing.
shell_kind_of() {
  case "$(basename "${1:-}")" in
    *zsh)  printf 'zsh' ;;
    *bash) printf 'bash' ;;
    *)     printf '' ;;
  esac
}

# resolve_shell_rc — the platform decides the package manager, but only the
# login shell decides which rc file is ever read. Choosing by distribution
# alone put an Amazon Linux cloud desktop's configuration into ~/.zshrc while
# the login shell was logbash: none of it was sourced, and sourcing it by hand
# printed zsh syntax errors from bash for every line.
#
# Precedence, strongest first:
#   --shell bash|zsh      the user said so outright
#   --set-default-shell   the user is switching to zsh, so target zsh
#   the login shell       whatever will actually read a file
#   the platform default  no login shell we recognise
resolve_shell_rc() {
  local kind="" login=""
  login=$(current_login_shell)

  if [ -n "$OPT_SHELL" ]; then
    kind="$OPT_SHELL"
    SHELL_RC_REASON="asked for with --shell"
  elif [ "$OPT_SET_DEFAULT_SHELL" -eq 1 ] && [ "$OS_KIND" != "ubuntu" ]; then
    kind="zsh"
    SHELL_RC_REASON="--set-default-shell is making zsh your login shell"
  else
    kind=$(shell_kind_of "$login")
    if [ -n "$kind" ]; then
      SHELL_RC_REASON="login shell is $login"
    else
      kind="$SHELL_KIND"
      if [ -n "$login" ]; then
        SHELL_RC_REASON="$OS_LABEL default; login shell $login is neither bash nor zsh"
      else
        SHELL_RC_REASON="$OS_LABEL default; could not read your login shell"
      fi
    fi
  fi

  SHELL_KIND="$kind"
  case "$kind" in
    zsh) SHELL_RC="$HOME/.zshrc" ;;
    *)   SHELL_RC="$HOME/.bashrc" ;;
  esac
}

# report_foreign_rc — the other rc file may already carry managed lines, either
# from a run under a different shell or from a version of this script that
# chose the file by distribution. Those lines are the failure this resolution
# exists to prevent, so say where they are. Never move or delete them: that
# file belongs to the user, and it is legitimate to configure both shells.
report_foreign_rc() {
  local other="" pat found
  case "$SHELL_KIND" in
    zsh) other="$HOME/.bashrc" ;;
    *)   other="$HOME/.zshrc" ;;
  esac
  [ -f "$other" ] || return 0

  pat=$(mktemp "${TMPDIR:-/tmp}/nanolander.XXXXXX") || return 0
  managed_lines > "$pat"
  found=$(grep -Fxc -f "$pat" "$other" 2>/dev/null)
  rm -f "$pat"
  [ "${found:-0}" -gt 0 ] || return 0

  warn "$other also carries $found managed line(s), and your login shell does not read it."
  info "They do nothing where they are, and sourcing that file from the other shell"
  info "prints syntax errors rather than working. Leave them, delete them by hand,"
  info "or re-run with --shell to configure that shell instead."
  return 0
}

# as_root — run a command with sudo unless we are already root. macOS never
# needs it because Homebrew refuses to run as root.
as_root() {
  if [ "$(id -u)" = "0" ]; then
    "$@"
  else
    sudo "$@"
  fi
}

ensure_sudo() {
  [ "$OS_KIND" = "macos" ] && return 0
  [ "$(id -u)" = "0" ] && return 0
  if ! command -v sudo >/dev/null 2>&1; then
    fail "sudo is not available and this is not a root shell."
    return "$EXIT_ENV"
  fi
  info "Checking sudo access (you may be asked for your password)."
  if ! sudo -v; then
    fail "sudo authentication failed."
    return "$EXIT_ENV"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# setup_homebrew — macOS only. Homebrew is a hard dependency there, so a
# failure here aborts the run.
# ---------------------------------------------------------------------------
setup_homebrew() {
  [ "$OS_KIND" = "macos" ] || return 0
  local prefix
  if ! command -v brew >/dev/null 2>&1; then
    info "Homebrew not found; running the official installer non-interactively."
    if ! NONINTERACTIVE=1 /bin/bash -c \
      "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
      fail "Homebrew installation failed; every macOS step depends on it."
      return "$EXIT_ENV"
    fi
  fi
  for prefix in /opt/homebrew /usr/local; do
    if [ -x "$prefix/bin/brew" ]; then
      BREW_BIN="$prefix/bin/brew"
      eval "$("$BREW_BIN" shellenv)"
      break
    fi
  done
  if [ -z "$BREW_BIN" ]; then
    if command -v brew >/dev/null 2>&1; then
      BREW_BIN=$(command -v brew)
      eval "$("$BREW_BIN" shellenv)"
    else
      fail "Homebrew is installed but brew could not be located."
      return "$EXIT_ENV"
    fi
  fi
  ok "Homebrew ready: $BREW_BIN"
  return 0
}

# ---------------------------------------------------------------------------
# Package manager abstraction. Each of the three questions — does the
# repository carry it, is it already installed, install it — is answered per
# package manager so the callers stay platform agnostic.
# ---------------------------------------------------------------------------
package_available() {
  local pkg="$1" candidate
  case "$PKG_MANAGER" in
    brew)
      brew info --formula "$pkg" >/dev/null 2>&1 ;;
    apt-get)
      candidate=$(apt-cache policy "$pkg" 2>/dev/null | awk '/Candidate:/ {print $2; exit}')
      [ -n "$candidate" ] && [ "$candidate" != "(none)" ] ;;
    dnf)
      dnf -q info "$pkg" >/dev/null 2>&1 ;;
    yum)
      yum -q info "$pkg" >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

package_installed() {
  local pkg="$1"
  case "$PKG_MANAGER" in
    brew)    brew list --formula --versions "$pkg" >/dev/null 2>&1 ;;
    apt-get) dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'ok installed' ;;
    dnf|yum) rpm -q "$pkg" >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

install_package() {
  local pkg="$1"
  case "$PKG_MANAGER" in
    brew)    brew install "$pkg" ;;
    apt-get) as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y "$pkg" ;;
    dnf)     as_root dnf install -y "$pkg" ;;
    yum)     as_root yum install -y "$pkg" ;;
    *) return 1 ;;
  esac
}

refresh_package_index() {
  section "Refreshing package index"
  case "$PKG_MANAGER" in
    brew)
      # A stale Homebrew index is inconvenient, not fatal.
      if brew update; then ok "Homebrew index updated."; else warn "brew update failed; continuing with the current index."; fi
      ;;
    apt-get)
      if ! as_root apt-get update -y; then
        fail "apt-get update failed; cannot install packages reliably."
        return "$EXIT_ENV"
      fi
      ok "APT index updated."
      ;;
    dnf)
      if ! as_root dnf -y makecache; then
        fail "dnf makecache failed."
        return "$EXIT_ENV"
      fi
      ok "DNF cache built."
      ;;
    yum)
      if ! as_root yum -y makecache; then
        fail "yum makecache failed."
        return "$EXIT_ENV"
      fi
      ok "YUM cache built."
      ;;
  esac
  return 0
}

# ---------------------------------------------------------------------------
# pkg_candidates — the same tool is named differently across distributions,
# so each one gets an ordered list of names to try.
# ---------------------------------------------------------------------------
pkg_candidates() {
  local cmd="$1"
  case "$cmd" in
    btop)       printf 'btop' ;;
    htop)       printf 'htop' ;;
    btm)        printf 'bottom btm' ;;
    fastfetch)  printf 'fastfetch' ;;
    lazygit)    printf 'lazygit' ;;
    tig)        printf 'tig' ;;
    delta)      printf 'git-delta delta' ;;
    difft)      printf 'difftastic' ;;
    gh)         printf 'gh github-cli' ;;
    git)        printf 'git' ;;
    ctags)      printf 'universal-ctags ctags exuberant-ctags' ;;
    cscope)     printf 'cscope' ;;
    # Homebrew's tree-sitter is the library with no binary in it at all; the
    # command lives in tree-sitter-cli, which is also Debian's name for it.
    tree-sitter) printf 'tree-sitter-cli tree-sitter' ;;
    shellcheck) printf 'shellcheck ShellCheck' ;;
    shfmt)      printf 'shfmt' ;;
    just)       printf 'just' ;;
    entr)       printf 'entr' ;;
    direnv)     printf 'direnv' ;;
    lazydocker) printf 'lazydocker' ;;
    dive)       printf 'dive' ;;
    nvim)       printf 'neovim' ;;
    neovide)    printf 'neovide' ;;
    tmux)       printf 'tmux' ;;
    starship)   printf 'starship' ;;
    zoxide)     printf 'zoxide' ;;
    nerd-font)  printf '' ;;   # same upstream release on every platform
    yazi)       printf 'yazi' ;;
    eza)        printf 'eza' ;;
    bat)        printf 'bat' ;;
    fd)         printf 'fd fd-find' ;;
    rg)         printf 'ripgrep' ;;
    sd)         printf 'sd sd-find-replace' ;;
    fzf)        printf 'fzf' ;;
    tree)       printf 'tree' ;;
    # Homebrew cannot have a formula called file, so its name is file-formula.
    file)       printf 'file file-formula' ;;
    # Amazon Linux 2023 carries the patent-free rebuild under its own name.
    ffmpeg)     printf 'ffmpeg ffmpeg-free' ;;
    pdftoppm)   printf 'poppler poppler-utils' ;;
    # brew's sevenzip and Ubuntu's 7zip give 7zz; the older p7zip packages give
    # 7z instead, which make_compat_links then links to 7zz.
    7zz)        printf 'sevenzip 7zip p7zip p7zip-plugins p7zip-full' ;;
    magick)     printf 'imagemagick ImageMagick' ;;
    resvg)      printf 'resvg' ;;
    dust)       printf 'dust du-dust' ;;
    duf)        printf 'duf' ;;
    ncdu)       printf 'ncdu' ;;
    jq)         printf 'jq' ;;
    yq)         printf 'yq' ;;
    glow)       printf 'glow' ;;
    tldr)       printf 'tlrc tldr' ;;
    xh)         printf 'xh' ;;
    gping)      printf 'gping' ;;
    hyperfine)  printf 'hyperfine' ;;
    wget)       printf 'wget' ;;
    watch)      printf 'procps-ng procps watch' ;;
    rsync)      printf 'rsync' ;;
    unzip)      printf 'unzip' ;;
    *)          printf '%s' "$cmd" ;;
  esac
}

# try_package_candidates — walk the candidate names in order and stop at the
# first one that is already installed or installs cleanly.
# PKG_ATTEMPTED records whether an install was actually run, so that "this
# distribution does not carry the tool" can be told apart from "the install
# broke". The first is a platform gap; the second is a failure the user needs
# to see, and a misconfigured apt must not be reported as a quiet skip.
try_package_candidates() {
  local cmd="$1" pkg
  PKG_ATTEMPTED=0
  for pkg in $(pkg_candidates "$cmd"); do
    if package_installed "$pkg"; then
      INSTALL_SOURCE="existing"
      return 0
    fi
  done
  for pkg in $(pkg_candidates "$cmd"); do
    if package_available "$pkg"; then
      info "Installing package $pkg"
      PKG_ATTEMPTED=1
      if install_package "$pkg"; then
        INSTALL_SOURCE="package manager"
        return 0
      fi
      warn "Package install failed: $pkg"
    fi
  done
  return 1
}

# ---------------------------------------------------------------------------
# github_repo — the upstream project for tools the repositories often lack.
# An empty result means "package manager only": tig, cscope, entr and ctags
# publish no cross-platform binaries at all, and neither do Poppler,
# ImageMagick or file, which every supported distribution does package.
# ---------------------------------------------------------------------------
github_repo() {
  case "$1" in
    btop)       printf 'aristocratos/btop' ;;
    btm)        printf 'ClementTsang/bottom' ;;
    fastfetch)  printf 'fastfetch-cli/fastfetch' ;;
    lazygit)    printf 'jesseduffield/lazygit' ;;
    delta)      printf 'dandavison/delta' ;;
    difft)      printf 'Wilfred/difftastic' ;;
    gh)         printf 'cli/cli' ;;
    shellcheck) printf 'koalaman/shellcheck' ;;
    shfmt)      printf 'mvdan/sh' ;;
    just)       printf 'casey/just' ;;
    direnv)     printf 'direnv/direnv' ;;
    lazydocker) printf 'jesseduffield/lazydocker' ;;
    dive)       printf 'wagoodman/dive' ;;
    nvim)       printf 'neovim/neovim' ;;
    neovide)    printf 'neovide/neovide' ;;
    tree-sitter) printf 'tree-sitter/tree-sitter' ;;
    starship)   printf 'starship/starship' ;;
    zoxide)     printf 'ajeetdsouza/zoxide' ;;
    yazi)       printf 'sxyazi/yazi' ;;
    ffmpeg)     printf 'BtbN/FFmpeg-Builds' ;;
    7zz)        printf 'ip7z/7zip' ;;
    resvg)      printf 'linebender/resvg' ;;
    eza)        printf 'eza-community/eza' ;;
    bat)        printf 'sharkdp/bat' ;;
    fd)         printf 'sharkdp/fd' ;;
    rg)         printf 'BurntSushi/ripgrep' ;;
    sd)         printf 'chmln/sd' ;;
    fzf)        printf 'junegunn/fzf' ;;
    dust)       printf 'bootandy/dust' ;;
    duf)        printf 'muesli/duf' ;;
    jq)         printf 'jqlang/jq' ;;
    yq)         printf 'mikefarah/yq' ;;
    glow)       printf 'charmbracelet/glow' ;;
    tldr)       printf 'tldr-pages/tlrc' ;;
    xh)         printf 'ducaale/xh' ;;
    gping)      printf 'orf/gping' ;;
    hyperfine)  printf 'sharkdp/hyperfine' ;;
    *)          printf '' ;;
  esac
}

# ---------------------------------------------------------------------------
# github_asset_name — the exact release asset to take on Linux, for the three
# projects where keyword matching picks the wrong file. An empty result means
# "let select_asset decide", which is the case for everything else.
#
# yazi and gping: upstream ships a gnu and a musl build of each target. The gnu
# one is linked against a newer glibc than the distribution has — Amazon Linux 2
# for yazi, and Amazon Linux 2023 for gping, whose gnu build wants 2.39 against
# the 2.34 that is there — so it installs and then cannot run. The musl build is
# static and runs on all four platforms, so it is the one to take everywhere
# rather than only where the mismatch shows up.
#
# FFmpeg-Builds: every target comes as -gpl and -gpl-shared, and containment
# finds the shared one first because it sorts earlier. Its ffmpeg needs the
# archive's lib directory, which we throw away, so it would install a binary
# that dies on its first invocation.
#
# macOS is not listed: there every tool comes from Homebrew and the release
# path is never reached.
# ---------------------------------------------------------------------------
github_asset_name() {
  [ "$OS_KIND" = "macos" ] && return 0
  case "$1" in
    yazi)
      case "$ARCH" in
        arm64)  printf 'yazi-aarch64-unknown-linux-musl.zip' ;;
        x86_64) printf 'yazi-x86_64-unknown-linux-musl.zip' ;;
      esac ;;
    gping)
      case "$ARCH" in
        arm64)  printf 'gping-Linux-musl-arm64.tar.gz' ;;
        x86_64) printf 'gping-Linux-musl-x86_64.tar.gz' ;;
        armv7)  printf 'gping-Linux-musleabihf-armv7.tar.gz' ;;
      esac ;;
    ffmpeg)
      case "$ARCH" in
        arm64)  printf 'ffmpeg-master-latest-linuxarm64-gpl.tar.xz' ;;
        x86_64) printf 'ffmpeg-master-latest-linux64-gpl.tar.xz' ;;
      esac ;;
  esac
  return 0
}

# github_extras — further binaries to take out of the same archive, because the
# catalog command on its own is only half the tool.
#
# yazi ships `ya`, which is what runs `ya pkg` for plugins and `ya emit` for the
# shell integration. FFmpeg ships ffprobe, and ffprobe is the half yazi
# actually calls to read a video's dimensions and duration.
github_extras() {
  case "$1" in
    yazi)   printf 'ya' ;;
    ffmpeg) printf 'ffprobe' ;;
    *)      printf '' ;;
  esac
}

# ---------------------------------------------------------------------------
# GitHub release installation
# ---------------------------------------------------------------------------
github_api() {
  local url="$1"
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    curl -fsSL --retry 2 --connect-timeout 15 \
      -H "Accept: application/vnd.github+json" \
      -H "Authorization: Bearer $GITHUB_TOKEN" "$url"
  else
    curl -fsSL --retry 2 --connect-timeout 15 \
      -H "Accept: application/vnd.github+json" "$url"
  fi
}

# parse_assets — emit "url<TAB>sha256" per release asset. Collapsing the JSON
# and splitting on '{' puts each asset object on its own line, which keeps the
# digest paired with the download URL it belongs to. No jq: jq is one of the
# tools we may still be installing.
parse_assets() {
  local chunk url digest
  # The final chunk carries no trailing newline, so read returns non-zero on
  # it; without the || guard the last asset in the release is dropped.
  tr -d '\n' | tr '{' '\n' | while IFS= read -r chunk || [ -n "$chunk" ]; do
    case "$chunk" in
      *browser_download_url*) ;;
      *) continue ;;
    esac
    url=$(printf '%s' "$chunk" | sed -n 's/.*"browser_download_url"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    digest=$(printf '%s' "$chunk" | sed -n 's/.*"digest"[[:space:]]*:[[:space:]]*"sha256:\([0-9a-fA-F]*\)".*/\1/p')
    [ -n "$url" ] && printf '%s\t%s\n' "$url" "$digest"
  done
}

strip_archive_ext() {
  local name="$1"
  case "$name" in
    *.tar.gz)  printf '%s' "${name%.tar.gz}" ;;
    *.tar.xz)  printf '%s' "${name%.tar.xz}" ;;
    *.tar.bz2) printf '%s' "${name%.tar.bz2}" ;;
    *.tgz)     printf '%s' "${name%.tgz}" ;;
    *.tbz)     printf '%s' "${name%.tbz}" ;;
    *.txz)     printf '%s' "${name%.txz}" ;;
    *.tar)     printf '%s' "${name%.tar}" ;;
    *.zip)     printf '%s' "${name%.zip}" ;;
    *.gz)      printf '%s' "${name%.gz}" ;;
    *)         printf '%s' "$name" ;;
  esac
}

# An uncompressed .tar counts: Neovide publishes neovide-linux-x86_64.tar with
# no compression at all, and without this entry the tarball itself was copied
# into ~/.local/bin as the binary — which then failed with an exec format error.
is_archive() {
  case "$1" in
    *.tar.gz|*.tar.xz|*.tar.bz2|*.tgz|*.tbz|*.txz|*.tar|*.zip|*.gz) return 0 ;;
    *) return 1 ;;
  esac
}

# Signatures, checksums, distro packages and installers are never what we want.
asset_excluded() {
  case "$1" in
    *.sha256|*.sha256sum|*.sha512|*.asc|*.sig|*.pem|*.sbom*|*.json|*.txt|*.md) return 0 ;;
    *.deb|*.rpm|*.apk|*.msi|*.exe|*.pkg|*.dmg|*.appimage) return 0 ;;
    *checksums*|*sha256sums*|*source*|*-src-*|*debug*) return 0 ;;
    *) return 1 ;;
  esac
}

asset_os_ok() {
  local lower="$1" kw
  for kw in $OS_KEYWORDS; do
    case "$lower" in *"$kw"*) return 0 ;; esac
  done
  return 1
}

# select_asset — full suffix match on every architecture keyword first, then
# substring containment. That ordering is what stops linux_arm from matching
# an asset actually built for linux_arm64.
select_asset() {
  local assets="$1" kw url digest base lower stem
  PICKED_URL=""
  PICKED_DIGEST=""

  for kw in $ARCH_KEYWORDS; do
    while IFS="$(printf '\t')" read -r url digest; do
      [ -n "$url" ] || continue
      base=$(basename "$url")
      lower=$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')
      asset_excluded "$lower" && continue
      asset_os_ok "$lower" || continue
      stem=$(strip_archive_ext "$lower")
      if [ "$stem" != "${stem%"$kw"}" ]; then
        PICKED_URL="$url"; PICKED_DIGEST="$digest"; return 0
      fi
    done <<ASSETS
$assets
ASSETS
  done

  for kw in $ARCH_KEYWORDS; do
    while IFS="$(printf '\t')" read -r url digest; do
      [ -n "$url" ] || continue
      base=$(basename "$url")
      lower=$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')
      asset_excluded "$lower" && continue
      asset_os_ok "$lower" || continue
      case "$lower" in
        *"$kw"*) PICKED_URL="$url"; PICKED_DIGEST="$digest"; return 0 ;;
      esac
    done <<ASSETS
$assets
ASSETS
  done

  return 1
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    return 1
  fi
}

extract_archive() {
  local file="$1" dest="$2"
  case "$file" in
    *.zip)
      if command -v unzip >/dev/null 2>&1; then
        unzip -q -o "$file" -d "$dest"
      else
        warn "unzip is not available yet; cannot extract $(basename "$file")."
        return 1
      fi
      ;;
    *.tar.gz|*.tgz)
      tar -xf "$file" -C "$dest" ;;
    *.tar.xz|*.txz)
      # GNU tar shells out to xz, which a minimal image may not carry. Say so
      # rather than reporting an unexplained extraction failure.
      if ! tar -xf "$file" -C "$dest"; then
        warn "Could not unpack $(basename "$file"); xz may be missing (install xz or xz-utils)."
        return 1
      fi ;;
    *.gz)
      # A lone gzipped binary, as some projects publish instead of a tarball.
      gunzip -c "$file" > "$dest/$(basename "${file%.gz}")" ;;
    *) tar -xf "$file" -C "$dest" ;;
  esac
}

# find_payload — locate the executable inside an extracted tree. An exact
# basename match wins; otherwise a prefix match catches projects that ship the
# binary under a decorated name (yq_linux_amd64, shfmt_v3.10.0_linux_amd64,
# direnv.linux-amd64), which is then installed under the plain command name.
#
# Each pass prefers an executable file, because an archive can hold more than
# one file with the command's name and only one of them is the program:
# fastfetch ships both usr/bin/fastfetch and a bash-completion script called
# usr/share/bash-completion/completions/fastfetch. `find` walks directories in
# readdir order, so without this the wrong one wins on some machines and not
# others. The mode is the reliable discriminator — upstream ships the
# completion 0644 — but it cannot be the only rule: a release that publishes a
# bare binary lands here as the 0644 file curl just wrote, hence the fallback
# to an exact match of any mode.
find_payload() {
  local root="$1" cmd="$2" found
  found=$(find "$root" -type f -perm -100 -name "$cmd" 2>/dev/null | head -1)
  if [ -n "$found" ]; then printf '%s' "$found"; return 0; fi
  found=$(find "$root" -type f -name "$cmd" 2>/dev/null | head -1)
  if [ -n "$found" ]; then printf '%s' "$found"; return 0; fi
  found=$(find "$root" -type f -perm -100 -name "$cmd*" 2>/dev/null \
    | grep -v -E '\.(1|md|txt|json|ps1|fish|zsh|bash|gz|tar)$' | head -1)
  if [ -n "$found" ]; then printf '%s' "$found"; return 0; fi
  found=$(find "$root" -type f -name "$cmd*" 2>/dev/null \
    | grep -v -E '\.(1|md|txt|json|ps1|fish|zsh|bash|gz|tar)$' | head -1)
  if [ -n "$found" ]; then printf '%s' "$found"; return 0; fi
  return 1
}

# install_neovim_tree — Neovim needs its runtime directory, so the release is
# kept whole under ~/.local/opt/nvim-github and only the binary is linked.
install_neovim_tree() {
  local extracted="$1" top target
  top=$(find "$extracted" -maxdepth 2 -type d -name 'bin' 2>/dev/null | head -1)
  [ -n "$top" ] || return 1
  top=$(dirname "$top")
  target="$LOCAL_OPT/nvim-github"
  rm -rf "$target"
  mkdir -p "$LOCAL_OPT"
  cp -R "$top" "$target" || return 1
  mkdir -p "$LOCAL_BIN"
  ln -sf "$target/bin/nvim" "$LOCAL_BIN/nvim"
  record_installed "$target"
  record_installed "$LOCAL_BIN/nvim"
  return 0
}

github_install() {
  local cmd="$1" repo="$2"
  local json assets tmp file actual payload want extra extra_payload

  [ -n "$repo" ] || return 1
  command -v curl >/dev/null 2>&1 || { warn "curl is required for GitHub release installs."; return 1; }

  info "Querying the latest release of $repo"
  json=$(github_api "https://api.github.com/repos/$repo/releases/latest") || {
    warn "GitHub API call failed for $repo (rate limit? set GITHUB_TOKEN)."
    return 1
  }

  assets=$(printf '%s' "$json" | parse_assets)
  if [ -z "$assets" ]; then
    warn "No downloadable assets in the latest $repo release."
    return 1
  fi

  # An exact name wins where keyword matching is known to pick the wrong file.
  # If upstream ever renames that asset, fall back to matching rather than
  # failing outright.
  want=$(github_asset_name "$cmd")
  if [ -n "$want" ] && ! select_named_asset "$assets" "$want"; then
    warn "$repo no longer publishes $want; falling back to keyword matching."
    want=""
  fi
  if [ -z "$want" ] && ! select_asset "$assets"; then
    warn "No $repo asset matches $OS_KIND/$ARCH."
    return 1
  fi

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/nanolander.XXXXXX") || return 1
  file="$tmp/$(basename "$PICKED_URL")"

  info "Downloading $(basename "$PICKED_URL")"
  if ! curl -fsSL --retry 2 --connect-timeout 20 -o "$file" "$PICKED_URL"; then
    warn "Download failed: $PICKED_URL"
    rm -rf "$tmp"
    return 1
  fi

  if [ -n "$PICKED_DIGEST" ]; then
    actual=$(sha256_of "$file")
    if [ -z "$actual" ]; then
      warn "No sha256 tool available; skipping digest verification for $cmd."
    elif [ "$actual" != "$PICKED_DIGEST" ]; then
      fail "SHA-256 mismatch for $cmd; refusing to install."
      rm -rf "$tmp"
      return 1
    else
      ok "SHA-256 verified for $cmd."
    fi
  fi

  mkdir -p "$tmp/x"
  # A .zip asset needs unzip, which sits at the end of the catalog and so may
  # not be installed yet when an earlier tool ships one. Same reason the font
  # pulls unzip forward.
  case "$file" in
    *.zip)
      if ! command -v unzip >/dev/null 2>&1; then
        info "unzip is needed to unpack $(basename "$file"); installing it first."
        try_package_candidates unzip >/dev/null 2>&1
      fi ;;
  esac
  if is_archive "$file"; then
    if ! extract_archive "$file" "$tmp/x"; then
      warn "Could not extract $(basename "$file")."
      rm -rf "$tmp"
      return 1
    fi
  else
    # Projects such as shfmt, direnv, jq and yq publish a bare binary.
    cp "$file" "$tmp/x/$cmd"
  fi

  mkdir -p "$LOCAL_BIN"

  if [ "$cmd" = "nvim" ]; then
    if install_neovim_tree "$tmp/x"; then
      rm -rf "$tmp"
      INSTALL_SOURCE="GitHub release"
      return 0
    fi
    warn "Unexpected Neovim release layout."
    rm -rf "$tmp"
    return 1
  fi

  payload=$(find_payload "$tmp/x" "$cmd") || {
    warn "Could not find a $cmd executable inside the release archive."
    rm -rf "$tmp"
    return 1
  }

  if ! install -m 0755 "$payload" "$LOCAL_BIN/$cmd" 2>/dev/null; then
    cp "$payload" "$LOCAL_BIN/$cmd" && chmod 0755 "$LOCAL_BIN/$cmd"
  fi

  # A missing extra is a warning, not a failure: the catalog command is there
  # and works, and that is what the summary reports on.
  for extra in $(github_extras "$cmd"); do
    if ! extra_payload=$(find_payload "$tmp/x" "$extra"); then
      warn "No $extra alongside $cmd in the $repo archive."
      continue
    fi
    if ! install -m 0755 "$extra_payload" "$LOCAL_BIN/$extra" 2>/dev/null; then
      cp "$extra_payload" "$LOCAL_BIN/$extra" && chmod 0755 "$LOCAL_BIN/$extra"
    fi
    if [ -x "$LOCAL_BIN/$extra" ]; then
      record_installed "$LOCAL_BIN/$extra"
      ok "Installed $extra alongside $cmd."
    fi
  done

  rm -rf "$tmp"

  if [ -x "$LOCAL_BIN/$cmd" ]; then
    record_installed "$LOCAL_BIN/$cmd"
    INSTALL_SOURCE="GitHub release"
    return 0
  fi
  return 1
}

# ---------------------------------------------------------------------------
# Nerd Font
#
# Starship's default prompt and eza's icons draw glyphs from the Nerd Font
# range. Without the font a terminal shows a box for every one of them, which
# is what "the prompt looks broken after installing" turns out to be.
#
# The font comes from the upstream release on all four platforms, never from a
# package manager, so macOS, Ubuntu and both Amazon Linux versions end up with
# byte-identical font files. Only the install directory differs.
# ---------------------------------------------------------------------------
font_dir() {
  if [ "$OS_KIND" = "macos" ]; then
    # macOS does not scan subdirectories of ~/Library/Fonts, so files go here
    # directly rather than into a folder of our own.
    printf '%s' "$HOME/Library/Fonts"
  else
    printf '%s' "${XDG_DATA_HOME:-$HOME/.local/share}/fonts"
  fi
}

# Any Nerd Font counts. If one is already there we leave it alone rather than
# installing a second family over the top of the user's choice.
nerd_font_installed() {
  local dir candidate
  dir=$(font_dir)
  [ -d "$dir" ] || return 1
  for candidate in "$dir"/*NerdFont*; do
    [ -f "$candidate" ] && return 0
  done
  return 1
}

# select_named_asset — pick a release asset by exact file name. The font
# release carries one archive per family rather than per architecture, so the
# suffix matching select_asset does is the wrong tool here.
select_named_asset() {
  local assets="$1" want="$2" url digest
  PICKED_URL=""
  PICKED_DIGEST=""
  while IFS="$(printf '\t')" read -r url digest; do
    [ -n "$url" ] || continue
    if [ "$(basename "$url")" = "$want" ]; then
      PICKED_URL="$url"
      PICKED_DIGEST="$digest"
      return 0
    fi
  done <<ASSETS
$assets
ASSETS
  return 1
}

install_nerd_font() {
  local json assets tmp file dir actual want copied=0 candidate target

  command -v curl >/dev/null 2>&1 || { warn "curl is required to fetch the font."; return 1; }

  # unzip sits late in the catalog, so it may not be installed yet when we get
  # here. The font archive needs it.
  if ! command -v unzip >/dev/null 2>&1; then
    info "unzip is needed to unpack the font; installing it first."
    try_package_candidates unzip >/dev/null 2>&1
  fi
  if ! command -v unzip >/dev/null 2>&1; then
    warn "unzip is unavailable; cannot unpack the font archive."
    return 1
  fi

  want="${NERD_FONT_FAMILY}.zip"
  info "Querying the latest release of $NERD_FONT_REPO"
  json=$(github_api "https://api.github.com/repos/$NERD_FONT_REPO/releases/latest") || {
    warn "GitHub API call failed for $NERD_FONT_REPO (rate limit? set GITHUB_TOKEN)."
    return 1
  }

  assets=$(printf '%s' "$json" | parse_assets)
  if ! select_named_asset "$assets" "$want"; then
    warn "No asset named $want in the latest $NERD_FONT_REPO release."
    info "Set NANOLANDER_NERD_FONT to a family that exists, for example Hack or Meslo."
    return 1
  fi

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/nanolander.XXXXXX") || return 1
  file="$tmp/$want"

  info "Downloading $want"
  if ! curl -fsSL --retry 2 --connect-timeout 20 -o "$file" "$PICKED_URL"; then
    warn "Download failed: $PICKED_URL"
    rm -rf "$tmp"
    return 1
  fi

  if [ -n "$PICKED_DIGEST" ]; then
    actual=$(sha256_of "$file")
    if [ -z "$actual" ]; then
      warn "No sha256 tool available; skipping digest verification for the font."
    elif [ "$actual" != "$PICKED_DIGEST" ]; then
      fail "SHA-256 mismatch for $want; refusing to install."
      rm -rf "$tmp"
      return 1
    else
      ok "SHA-256 verified for $want."
    fi
  fi

  mkdir -p "$tmp/x"
  if ! unzip -q -o "$file" -d "$tmp/x"; then
    warn "Could not unpack $want."
    rm -rf "$tmp"
    return 1
  fi

  dir=$(font_dir)
  mkdir -p "$dir" || { rm -rf "$tmp"; return 1; }

  # Install the monospaced cut only. The archive also ships proportional and
  # variable-width variants, which a terminal cannot use and which would bury
  # the useful faces in every font picker on the machine.
  for candidate in "$tmp/x"/*NerdFontMono-*.ttf; do
    [ -f "$candidate" ] || continue
    target="$dir/$(basename "$candidate")"
    if cp "$candidate" "$target"; then
      record_installed "$target"
      copied=$((copied + 1))
    fi
  done

  if [ "$copied" -eq 0 ]; then
    warn "The $want archive held no NerdFontMono faces; nothing installed."
    rm -rf "$tmp"
    return 1
  fi

  rm -rf "$tmp"

  # fontconfig has to be told, otherwise the font stays invisible until the
  # next login. macOS picks up ~/Library/Fonts on its own.
  if [ "$OS_KIND" != "macos" ] && command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f "$dir" >/dev/null 2>&1
  fi

  ok "Installed $copied $NERD_FONT_FAMILY Nerd Font face(s) into $dir"
  return 0
}

ensure_nerd_font() {
  local cmd="$1" name="$2" dir
  dir=$(font_dir)

  if ! wants_tool "$cmd" "$name"; then
    record_result "$cmd" "SKIPPED" "filter" "-"
    return 0
  fi

  section "Installing $name"

  if nerd_font_installed; then
    ok "A Nerd Font is already installed in $dir"
    record_result "$cmd" "SUCCESS" "existing" "$dir"
    return 0
  fi

  if install_nerd_font; then
    record_result "$cmd" "SUCCESS" "GitHub release" "$dir"
    info "Now select \"$NERD_FONT_FAMILY Nerd Font Mono\" as your terminal's font."
    info "Installing the font cannot change which font your terminal is set to."
    return 0
  fi

  fail "$name could not be installed."
  record_result "$cmd" "FAILED" "-" "-"
  return 1
}

# ---------------------------------------------------------------------------
# make_compat_links — Debian and Ubuntu ship fd as fdfind and bat as batcat.
# Linking them under the upstream names keeps muscle memory portable. The same
# problem turns up twice more among the preview backends: the older p7zip
# packages call the binary 7z rather than 7zz, and ImageMagick 6 — still what
# Ubuntu and Amazon Linux package — has convert but no magick.
# ---------------------------------------------------------------------------
make_compat_links() {
  mkdir -p "$LOCAL_BIN"
  if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
    ln -sf "$(command -v fdfind)" "$LOCAL_BIN/fd"
    record_installed "$LOCAL_BIN/fd"
    ok "Linked fdfind to $LOCAL_BIN/fd"
  fi
  if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
    ln -sf "$(command -v batcat)" "$LOCAL_BIN/bat"
    record_installed "$LOCAL_BIN/bat"
    ok "Linked batcat to $LOCAL_BIN/bat"
  fi
  if ! command -v 7zz >/dev/null 2>&1 && command -v 7z >/dev/null 2>&1; then
    ln -sf "$(command -v 7z)" "$LOCAL_BIN/7zz"
    record_installed "$LOCAL_BIN/7zz"
    ok "Linked 7z to $LOCAL_BIN/7zz"
  fi
  # ImageMagick 6's convert takes the same "convert in out" form the previewers
  # use, so the link is enough for them. It is not a general IM7 substitute.
  if ! command -v magick >/dev/null 2>&1 && command -v convert >/dev/null 2>&1; then
    ln -sf "$(command -v convert)" "$LOCAL_BIN/magick"
    record_installed "$LOCAL_BIN/magick"
    ok "Linked ImageMagick 6's convert to $LOCAL_BIN/magick"
  fi
}

# ---------------------------------------------------------------------------
# version_query — how each tool is asked for its version. tmux uses -V, unzip
# uses -v, cscope uses -V, pdftoppm uses -v and rejects --version, and
# ffmpeg's own spelling is -version. Split out from command_works so the exit
# status and the output belong to the query itself.
# ---------------------------------------------------------------------------
version_query() {
  case "$1" in
    tmux)          tmux -V ;;
    unzip)         unzip -v ;;
    cscope)        cscope -V ;;
    pdftoppm)      pdftoppm -v ;;
    ffmpeg)        ffmpeg -version ;;
    *)             "$1" --version ;;
  esac
}

# ---------------------------------------------------------------------------
# command_works — presence on PATH is not proof, so run the version query and
# require it to both succeed and say something. Exit status alone is too weak:
# a bash-completion script named after the command sources cleanly and exits 0
# in silence, which is how a completion file installed as ~/.local/bin/fastfetch
# was once reported verified. Version output goes to stdout for most of these
# and to stderr for pdftoppm, so both streams count.
#
# entr and 7-Zip have no version flag at all — a bare 7zz prints its banner and
# then a usage screen — so for those two being on PATH is the test.
# ---------------------------------------------------------------------------
command_works() {
  local cmd="$1" out
  # The font is the one catalog entry that installs no command at all.
  [ "$cmd" = "nerd-font" ] && { nerd_font_installed; return $?; }
  command -v "$cmd" >/dev/null 2>&1 || return 1
  case "$cmd" in
    entr|7zz) return 0 ;;
  esac
  out=$(version_query "$cmd" 2>&1) || return 1
  [ -n "$out" ]
}

# ---------------------------------------------------------------------------
# glibc_too_old_for — did this binary refuse to start because the system C
# library is older than the one it was linked against?
#
# Upstream increasingly builds against a newer glibc than an enterprise
# distribution carries. Amazon Linux 2023 is on 2.34, and the only Linux
# binaries tree-sitter, resvg and Neovide publish want 2.39, 2.35 and 2.35, so
# the loader stops them before main() runs:
#
#   tree-sitter: /lib64/libc.so.6: version `GLIBC_2.39' not found
#
# There is nothing wrong with the install and nothing a re-run would fix — the
# tool has no build for this platform, which is what SKIPPED (platform) means.
# Reporting it as FAILED made a complete run exit 2 on every Amazon Linux box.
#
# Read from the loader's own message rather than comparing version numbers:
# ldd is not on every image, its output format is not stable across libcs, and
# the binary itself is the authority on what it needs.
# ---------------------------------------------------------------------------
glibc_too_old_for() {
  local out
  command -v "$1" >/dev/null 2>&1 || return 1
  out=$(version_query "$1" 2>&1)
  case "$out" in
    *GLIBC_*"not found"*) return 0 ;;
    *) return 1 ;;
  esac
}

# system_glibc — "2.34", or empty where the question does not apply (macOS) or
# cannot be answered. Reported alongside the skip so the reason is legible.
system_glibc() {
  ldd --version 2>/dev/null | sed -n '1s/.*[^0-9]\(2\.[0-9][0-9]*\).*/\1/p'
}

# ---------------------------------------------------------------------------
# Result bookkeeping
# ---------------------------------------------------------------------------
record_result() {
  local cmd="$1" status="$2" source="$3" path="$4"
  RESULTS="${RESULTS}${cmd}|${status}|${source}|${path}
"
  # A tool the user filtered out and a tool this platform has no build for are
  # both SKIPPED in the table, and they were counted together — so a summary
  # reading "Skipped by filter: 5" on a run with no filter at all was the
  # closest thing to a report that four tools had nowhere to come from.
  case "$status" in
    SUCCESS) COUNT_SUCCESS=$((COUNT_SUCCESS + 1)) ;;
    FAILED)  COUNT_FAILED=$((COUNT_FAILED + 1)) ;;
    SKIPPED)
      case "$source" in
        filter) COUNT_SKIPPED=$((COUNT_SKIPPED + 1)) ;;
        *)      COUNT_ABSENT=$((COUNT_ABSENT + 1)) ;;
      esac ;;
  esac
}

# ---------------------------------------------------------------------------
# ensure_linux_tool — the install pipeline for one tool: filter, skip when
# already working, package manager, GitHub release fallback, then verify.
# ---------------------------------------------------------------------------
ensure_linux_tool() {
  local cmd="$1" name="$2" repo path glibc

  if ! wants_tool "$cmd" "$name"; then
    record_result "$cmd" "SKIPPED" "filter" "-"
    return 0
  fi

  section "Installing $name"
  INSTALL_SOURCE=""

  if command_works "$cmd"; then
    path=$(command -v "$cmd")
    ok "$name already present: $path"
    record_result "$cmd" "SUCCESS" "existing" "$path"
    return 0
  fi

  # A package can install cleanly and still not provide the command — brew's
  # tree-sitter is the library, not the binary — so the release fallback has
  # to be reachable from that case too.
  if try_package_candidates "$cmd" && command_works "$cmd"; then
    if [ "$INSTALL_SOURCE" = "package manager" ]; then
      ok "Installed $name from the $PKG_MANAGER repository."
    fi
  else
    warn "Package unavailable or failed: $name"
    repo=$(github_repo "$cmd")
    if [ -n "$repo" ]; then
      if github_install "$cmd" "$repo"; then
        ok "Installed $name from its official GitHub release."
      else
        INSTALL_SOURCE=""
      fi
    else
      warn "$name has no official cross-platform release; repository only."
    fi
  fi

  make_compat_links

  if command_works "$cmd"; then
    path=$(command -v "$cmd")
    ok "$name verified: $path"
    record_result "$cmd" "SUCCESS" "${INSTALL_SOURCE:-package manager}" "$path"
    return 0
  fi

  # The binary is there and will never run here. Leaving it on PATH is worse
  # than not having it — a half-working tree-sitter makes Neovim's parser build
  # fail in a way that points nowhere near the real cause — so it goes, and the
  # manifest entry it left behind is harmless because --uninstall skips paths
  # that are already gone.
  if glibc_too_old_for "$cmd"; then
    glibc=$(system_glibc)
    info "$name's build for $OS_LABEL needs a newer glibc than this system has${glibc:+ (glibc $glibc)}; skipping."
    rm -f "$LOCAL_BIN/$cmd"
    record_result "$cmd" "SKIPPED" "platform" "-"
    return 0
  fi

  # Nothing was ever attempted: no distribution package exists for this tool
  # here and the project publishes no cross-platform binary either. That is the
  # case tool_unsupported_here already calls a skip rather than a failure — it
  # just cannot be known ahead of time, because it depends on what this
  # distribution happens to carry. entr and ncdu land here on Amazon Linux.
  #
  # PKG_ATTEMPTED keeps a broken package manager out of this branch: an install
  # that ran and failed is a failure to report, not a platform without the tool.
  if [ "$PKG_ATTEMPTED" -eq 0 ] && [ -z "$(github_repo "$cmd")" ] &&
     ! command -v "$cmd" >/dev/null 2>&1; then
    info "$name is packaged by neither $PKG_MANAGER nor upstream on $OS_LABEL; skipping."
    record_result "$cmd" "SKIPPED" "platform" "-"
    return 0
  fi

  fail "$name could not be installed or verified."
  record_result "$cmd" "FAILED" "-" "-"
  return 1
}

# ensure_brew_tool — the macOS path. Homebrew carries every tool in the
# catalog, so this stays a thin wrapper with no release fallback.
ensure_brew_tool() {
  local cmd="$1" name="$2" path pkg

  if ! wants_tool "$cmd" "$name"; then
    record_result "$cmd" "SKIPPED" "filter" "-"
    return 0
  fi

  section "Installing $name"

  if command_works "$cmd"; then
    path=$(command -v "$cmd")
    ok "$name already present: $path"
    record_result "$cmd" "SUCCESS" "existing" "$path"
    return 0
  fi

  for pkg in $(pkg_candidates "$cmd"); do
    if ! brew install "$pkg"; then
      warn "brew install $pkg failed."
      continue
    fi
    # Installing cleanly is not the same as providing the command: brew's
    # tree-sitter formula is the library and ships no binary at all. Only stop
    # walking the candidates once the command is actually there.
    command_works "$cmd" && break
    warn "$pkg installed but provides no $cmd; trying the next candidate."
  done

  if command_works "$cmd"; then
    path=$(command -v "$cmd")
    ok "$name verified: $path"
    record_result "$cmd" "SUCCESS" "package manager" "$path"
    return 0
  fi

  fail "$name could not be installed or verified."
  record_result "$cmd" "FAILED" "-" "-"
  return 1
}

# ---------------------------------------------------------------------------
# tool_unsupported_here — the catalog is deliberately identical on all four
# platforms, with the exceptions below. Where upstream publishes nothing and no
# distribution packages the tool either, there is genuinely nothing to install,
# and calling that a failure would be wrong.
# ---------------------------------------------------------------------------
tool_unsupported_here() {
  case "$1" in
    neovide|resvg)
      # Both exist for macOS and x86_64 Linux only — Neovide because it is a
      # GUI client, resvg because upstream builds a single Linux target — and
      # neither is in the Debian, Ubuntu or Amazon Linux repositories. So on a
      # Graviton instance or a Raspberry Pi there is nothing to fetch.
      [ "$OS_KIND" = "macos" ] && return 1
      [ "$ARCH" = "x86_64" ] && return 1
      return 0 ;;
    yazi)
      # Upstream builds x86_64 and aarch64; no distribution packages yazi on
      # 32-bit ARM, so armv7 and armv6 have no route to it at all.
      case "$ARCH" in
        armv7|armv6) return 0 ;;
      esac
      return 1 ;;
    *) return 1 ;;
  esac
}

# ensure_tool — pick the install path for one catalog entry.
ensure_tool() {
  local cmd="$1" name="$2"

  if ! wants_tool "$cmd" "$name"; then
    record_result "$cmd" "SKIPPED" "filter" "-"
    return 0
  fi

  if tool_unsupported_here "$cmd"; then
    section "Installing $name"
    info "$name has no upstream build for $OS_LABEL on $ARCH; skipping."
    record_result "$cmd" "SKIPPED" "platform" "-"
    return 0
  fi

  if [ "$OS_KIND" = "macos" ]; then
    ensure_brew_tool "$cmd" "$name"
  else
    ensure_linux_tool "$cmd" "$name"
  fi
}

# install_all_tools — the catalog arrives on file descriptor 3, not on stdin.
#
# The loop body installs packages and unpacks releases, and those commands read
# stdin: dnf prompts before importing a repository GPG key, and a package
# manager may ask anything else it likes. With the catalog on stdin the first
# tool that actually installed something swallowed every remaining line, the
# loop ended there, and the summary called the run a success because each tool
# it did reach had passed. That is why six runs on one Amazon Linux box left it
# with seven of the fifty-four tools — one more per run.
#
# Descriptor 3 fixes it from both sides: the loop cannot lose its input, and
# stdin stays connected to the terminal so a package manager that really does
# need to ask the user can still be answered.
install_all_tools() {
  local cmd name category purpose
  while IFS='|' read -r cmd name category purpose <&3; do
    [ -n "$cmd" ] || continue
    case "$cmd" in
      # The font takes the same route on every platform, by design.
      nerd-font) ensure_nerd_font "$cmd" "$name" ;;
      *)         ensure_tool "$cmd" "$name" ;;
    esac
  done 3<<CATALOG
$TOOL_CATALOG
CATALOG
}

# ---------------------------------------------------------------------------
# Shell environment. Every line is compared in full before it is written, so
# re-running the script never duplicates a line.
# ---------------------------------------------------------------------------
# backup_file_once — copy a shell config file into ~/.nanolander-backups the
# first time this run is about to write to it. An empty or missing file has
# nothing to lose, so it is skipped. Returns non-zero only when there was
# something to save and saving it failed, which is the one case where the
# caller must not write.
# backup_path — the first free timestamped path for a file in a directory.
# Two runs inside the same second must not land on the same name: the second
# one would overwrite the first, destroying the only copy of the original.
backup_path() {
  local dir="$1" base="$2" stamp path n=1
  stamp=$(date +%Y%m%d-%H%M%S)
  path="$dir/$base.$stamp"
  while [ -e "$path" ]; do
    path="$dir/$base.$stamp-$n"
    n=$((n + 1))
  done
  printf '%s' "$path"
}

backup_file_once() {
  local file="$1" dest
  case " $BACKED_UP " in
    *" $file "*) return 0 ;;
  esac
  BACKED_UP="$BACKED_UP $file"
  [ -s "$file" ] || return 0
  if ! mkdir -p "$BACKUP_DIR" 2>/dev/null; then
    warn "Could not create $BACKUP_DIR; refusing to modify $file."
    return 1
  fi
  dest=$(backup_path "$BACKUP_DIR" "$(basename "$file")")
  if cp "$file" "$dest" 2>/dev/null; then
    ok "Backed up $file to $dest"
    return 0
  fi
  warn "Could not back up $file; refusing to modify it."
  return 1
}

# record_installed — remember a path this script created under ~/.local, so
# --uninstall can remove exactly that and nothing else.
record_installed() {
  local path="$1"
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  [ -f "$MANIFEST" ] || : > "$MANIFEST" 2>/dev/null || return 0
  grep -Fqx "$path" "$MANIFEST" 2>/dev/null && return 0
  printf '%s\n' "$path" >> "$MANIFEST" 2>/dev/null || return 0
  return 0
}

add_line_once() {
  local file="$1" line="$2"
  mkdir -p "$(dirname "$file")"
  [ -f "$file" ] || : > "$file"
  if grep -Fqx "$line" "$file" 2>/dev/null; then
    return 1
  fi
  backup_file_once "$file" || return 1
  printf '%s\n' "$line" >> "$file"
  return 0
}

# shell_line — every line nanolander may add to a shell rc file, in one
# place. configure_shell writes them and uninstall_shell_config removes them,
# so the two can never drift apart.
shell_line() {
  # The rc file must receive a literal $HOME, not this process's expansion,
  # so the PATH line below is deliberately single quoted.
  # shellcheck disable=SC2016
  case "$1" in
    path)     printf '%s' 'export PATH="$HOME/.local/bin:$PATH"' ;;
    zoxide)   printf 'eval "$(zoxide init %s)"' "$2" ;;
    starship) printf 'eval "$(starship init %s)"' "$2" ;;
    direnv)   printf 'eval "$(direnv hook %s)"' "$2" ;;
    fzf)      printf 'command -v fzf >/dev/null 2>&1 && eval "$(fzf --%s 2>/dev/null)" 2>/dev/null' "$2" ;;
    fzfcmd)   printf '%s' "export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'" ;;
    # Inside Neovim's own :terminal, $NVIM points at that Neovim's socket, so
    # `nvim file` there can hand the file to the editor you are already in
    # rather than starting a second one nested inside the pane. Outside
    # :terminal $NVIM is unset and this is a plain nvim.
    #
    # --remote, not --remote-wait: Neovim does not implement the wait commands
    # at all and answers E5600, so the shell cannot be made to block this way.
    # It does not need to. A shell function is invisible to the `sh -c` that
    # git runs $EDITOR through, so this line can only ever affect a command
    # typed at the prompt — never a $EDITOR call that must block. That case
    # belongs to flatten.nvim, which blocks over RPC instead.
    #
    # ${NVIM:-} rather than $NVIM: a shell running with `set -u` aborts on an
    # unset variable, and this line has to be harmless in every shell it lands
    # in, not just an ordinary interactive one.
    #
    # One line, because add_line_once compares whole lines and the uninstaller
    # removes by exact match.
    nvimremote) printf '%s' 'nvim() { if [ -n "${NVIM:-}" ] && [ $# -gt 0 ]; then command nvim --server "$NVIM" --remote "$@"; else command nvim "$@"; fi; }' ;;
  esac
}

configure_shell() {
  section "Configuring the shell"
  local rc="$SHELL_RC" sh="$SHELL_KIND"

  if add_line_once "$rc" "$(shell_line path)"; then
    ok "PATH entry added to $rc"
  else
    info "PATH entry already present in $rc"
  fi

  if [ "$OS_KIND" = "macos" ] && [ -n "$BREW_BIN" ]; then
    if add_line_once "$HOME/.zprofile" "eval \"\$($BREW_BIN shellenv)\""; then
      ok "Homebrew shellenv added to ~/.zprofile"
    else
      info "Homebrew shellenv already present in ~/.zprofile"
    fi
  fi

  if command_works zoxide; then
    add_line_once "$rc" "$(shell_line zoxide "$sh")" && ok "zoxide init added to $rc"
  fi
  if command_works starship; then
    add_line_once "$rc" "$(shell_line starship "$sh")" && ok "Starship init added to $rc"
  fi
  if command_works direnv; then
    add_line_once "$rc" "$(shell_line direnv "$sh")" && ok "direnv hook added to $rc"
  fi
  if command_works nvim; then
    add_line_once "$rc" "$(shell_line nvimremote)" \
      && ok "nvim remote-open wrapper added to $rc (nvim inside :terminal opens in the running editor)"
  fi

  # fzf lines are guarded and error-suppressed so that removing fzf later, or
  # running an older fzf without --zsh/--bash, never breaks shell startup.
  if command_works fzf; then
    add_line_once "$rc" "$(shell_line fzf "$sh")" \
      && ok "fzf key bindings added to $rc (Ctrl-R, Ctrl-T)"
    if command_works fd; then
      add_line_once "$rc" "$(shell_line fzfcmd)" \
        && ok "FZF_DEFAULT_COMMAND added to $rc"
    fi
  fi

  [ "$OPT_WITH_ALIASES" -eq 1 ] && add_alias_block "$rc"
  report_foreign_rc
  return 0
}

# The alias block is marked so it can be removed by deleting everything
# between the two markers. Each alias checks for its tool first, so a missing
# tool never breaks the shell.
add_alias_block() {
  local rc="$1"
  if grep -Fqx '# >>> nanolander aliases >>>' "$rc" 2>/dev/null; then
    info "Alias block already present in $rc"
    return 0
  fi
  backup_file_once "$rc" || return 1
  cat >> "$rc" <<'ALIASES'
# >>> nanolander aliases >>>
command -v eza >/dev/null 2>&1 && alias ls='eza --group-directories-first'
command -v eza >/dev/null 2>&1 && alias ll='eza -lah --group-directories-first --git'
command -v eza >/dev/null 2>&1 && alias lt='eza --tree --level=2'
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'
command -v dust >/dev/null 2>&1 && alias du='dust'
command -v duf >/dev/null 2>&1 && alias df='duf'
command -v btm >/dev/null 2>&1 && alias top='btm'
# <<< nanolander aliases <<<
ALIASES
  ok "Alias block added to $rc"
}

# ---------------------------------------------------------------------------
# Undoing a run
# ---------------------------------------------------------------------------

# managed_lines — write every line configure_shell is capable of adding to a
# pattern file, for both shell flavours, so removal cannot miss one.
managed_lines() {
  local sh key
  for sh in zsh bash; do
    for key in zoxide starship direnv fzf; do
      shell_line "$key" "$sh"
      printf '\n'
    done
  done
  shell_line path
  printf '\n'
  shell_line fzfcmd
  printf '\n'
  shell_line nvimremote
  printf '\n'
}

# remove_managed_lines — drop the fenced alias block and every managed line
# from one rc file, leaving everything the user wrote untouched.
remove_managed_lines() {
  local file="$1" pat tmp before after status
  [ -f "$file" ] || return 0

  before=$(wc -l < "$file" | tr -d ' ')
  pat=$(mktemp "${TMPDIR:-/tmp}/nanolander.XXXXXX") || return 1
  tmp=$(mktemp "${TMPDIR:-/tmp}/nanolander.XXXXXX") || { rm -f "$pat"; return 1; }
  managed_lines > "$pat"

  awk '
    /^# >>> nanolander aliases >>>$/ { skip = 1 }
    skip { if (/^# <<< nanolander aliases <<<$/) { skip = 0 } next }
    { print }
  ' "$file" | grep -Fxv -f "$pat" > "$tmp"
  status=$?
  # grep -v exits 1 when it selects nothing, which is a legitimate result for
  # an rc file that contained only our lines. Only 2 and above is an error.
  if [ "$status" -gt 1 ]; then
    warn "Could not filter $file; leaving it alone."
    rm -f "$pat" "$tmp"
    return 1
  fi

  after=$(wc -l < "$tmp" | tr -d ' ')
  if [ "$before" -eq "$after" ]; then
    info "Nothing of nanolander's in $file"
    rm -f "$pat" "$tmp"
    return 0
  fi

  if ! backup_file_once "$file"; then
    rm -f "$pat" "$tmp"
    return 1
  fi
  # Copy the contents rather than moving the file, so permissions, ownership
  # and any symlink at this path survive.
  if cat "$tmp" > "$file"; then
    ok "Removed $((before - after)) line(s) from $file"
  else
    fail "Could not rewrite $file"
    rm -f "$pat" "$tmp"
    return 1
  fi
  rm -f "$pat" "$tmp"
  return 0
}

# snapshot_before_restore — keep the current file before overwriting it, in a
# subdirectory so it is never picked up as a restore source. That keeps
# repeated --restore-shell runs idempotent instead of toggling back and forth.
snapshot_before_restore() {
  local file="$1" dest
  [ -s "$file" ] || return 0
  if ! mkdir -p "$BACKUP_DIR/pre-restore" 2>/dev/null; then
    warn "Could not create $BACKUP_DIR/pre-restore; leaving $file alone."
    return 1
  fi
  dest=$(backup_path "$BACKUP_DIR/pre-restore" "$(basename "$file")")
  if cp "$file" "$dest" 2>/dev/null; then
    info "Current $file saved to $dest"
    return 0
  fi
  warn "Could not save the current $file; leaving it alone."
  return 1
}

restore_shell() {
  section "Restoring shell configuration"
  local base candidate latest restored=0

  if [ ! -d "$BACKUP_DIR" ]; then
    fail "No backups found in $BACKUP_DIR"
    info "Backups are written the first time a run modifies a shell config file."
    return 1
  fi

  for base in .zshrc .bashrc .zprofile; do
    latest=""
    # Backups carry a sortable timestamp, so the last glob match is newest.
    for candidate in "$BACKUP_DIR/$base."*; do
      [ -f "$candidate" ] && latest="$candidate"
    done
    [ -n "$latest" ] || continue
    # Save the current state too, so a restore is itself undoable.
    snapshot_before_restore "$HOME/$base" || continue
    if cp "$latest" "$HOME/$base"; then
      ok "Restored $HOME/$base from $(basename "$latest")"
      restored=$((restored + 1))
    else
      fail "Could not restore $HOME/$base"
    fi
  done

  if [ "$restored" -eq 0 ]; then
    fail "No shell config backups found in $BACKUP_DIR"
    return 1
  fi
  info "Open a new shell, or run: exec \$SHELL -l"
  return 0
}

uninstall_tools() {
  section "Removing tools installed by nanolander"
  local path removed=0

  if [ ! -f "$MANIFEST" ]; then
    info "No install manifest at $MANIFEST."
    info "Nothing recorded, so nothing is removed. Anything installed before"
    info "this version has to be deleted from $LOCAL_BIN by hand."
    return 0
  fi

  while IFS= read -r path || [ -n "$path" ]; do
    [ -n "$path" ] || continue
    # Never delete outside the directories this script installs into,
    # whatever the manifest says. macOS fonts live outside ~/.local.
    case "$path" in
      "$LOCAL_BIN"/*|"$LOCAL_OPT"/*) ;;
      "$HOME"/Library/Fonts/*) ;;
      "${XDG_DATA_HOME:-$HOME/.local/share}"/fonts/*) ;;
      *) warn "Refusing to remove a path outside nanolander's install directories: $path"; continue ;;
    esac
    if [ -e "$path" ] || [ -L "$path" ]; then
      if rm -rf "$path"; then
        ok "Removed $path"
        removed=$((removed + 1))
      else
        warn "Could not remove $path"
      fi
    fi
  done < "$MANIFEST"

  rm -f "$MANIFEST"
  if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f >/dev/null 2>&1
  fi
  info "Removed $removed item(s)."
  info "Tools installed through the system package manager are left alone."
  return 0
}

uninstall_nanolander() {
  section "Removing nanolander's shell configuration"
  local base

  for base in .zshrc .bashrc; do
    remove_managed_lines "$HOME/$base"
  done

  if [ -f "$HOME/.zprofile" ] && grep -q 'brew shellenv' "$HOME/.zprofile" 2>/dev/null; then
    warn "$HOME/.zprofile still has a Homebrew shellenv line."
    info "It is left in place because removing it takes brew off your PATH,"
    info "and it may predate nanolander. Delete it by hand if you want it gone."
  fi

  uninstall_tools

  section "Done"
  info "Shell config backups remain in $BACKUP_DIR"
  info "Undo this with: ./bin/nanolander --restore-shell"
  info "Open a new shell, or run: exec \$SHELL -l"
  return 0
}

# script_dir — the directory holding this script, with $0 resolved through any
# symlinks. README suggests linking bin/nanolander onto PATH, and a bare
# dirname of the link would look for its siblings in the wrong place.
# readlink without -f, because macOS has no -f.
script_dir() {
  local src="$0" dir
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd) || return 1
    src=$(readlink "$src")
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  (cd -P "$(dirname "$src")" && pwd)
}

# install_nvim_config — hand off to the companion script rather than
# duplicating it. It does its own reporting, backup and restore.
install_nvim_config() {
  section "Installing the Neovim configuration"
  local helper
  helper="$(script_dir)/nvim-land"
  if [ ! -x "$helper" ]; then
    warn "Cannot find bin/nvim-land next to this script; skipping."
    info "It ships in the nanolander checkout. Run it there: ./bin/nvim-land"
    return 1
  fi
  if ! command_works nvim; then
    warn "Neovim is not installed, so there is no configuration to install."
    return 1
  fi
  info "Running: $helper --apply"
  if "$helper" --apply; then
    ok "Neovim configuration installed."
    return 0
  fi
  warn "nvim-land did not finish cleanly; run it directly to see why."
  return 1
}

configure_git_pager() {
  section "Configuring git"
  if ! command -v git >/dev/null 2>&1; then
    warn "git is not available; skipping --configure-git."
    return 1
  fi
  if ! command -v delta >/dev/null 2>&1; then
    warn "git-delta is not available; skipping --configure-git."
    return 1
  fi
  git config --global core.pager delta
  git config --global interactive.diffFilter 'delta --color-only'
  git config --global delta.navigate true
  git config --global delta.line-numbers true
  git config --global merge.conflictStyle zdiff3
  ok "git-delta set as the global git pager."
  return 0
}

set_default_shell() {
  section "Setting the default shell"
  if [ "$OS_KIND" = "ubuntu" ]; then
    info "Ubuntu is configured through ~/.bashrc; --set-default-shell has no effect."
    return 0
  fi

  local zsh_path current
  if ! command -v zsh >/dev/null 2>&1; then
    warn "zsh is not installed; cannot change the login shell."
    return 1
  fi
  zsh_path=$(command -v zsh)
  current=$(current_login_shell)

  if [ "$current" = "$zsh_path" ]; then
    info "Login shell is already $zsh_path"
    return 0
  fi

  # chsh refuses a shell that is not listed in /etc/shells.
  if [ "$OS_KIND" != "macos" ] && ! grep -Fqx "$zsh_path" /etc/shells 2>/dev/null; then
    if [ -w /etc/shells ]; then
      printf '%s\n' "$zsh_path" >> /etc/shells
    else
      as_root sh -c "printf '%s\\n' '$zsh_path' >> /etc/shells"
    fi
  fi

  if chsh -s "$zsh_path"; then
    ok "Login shell changed to $zsh_path (takes effect on next login)."
    return 0
  fi
  warn "chsh failed; change the login shell manually with: chsh -s $zsh_path"
  return 1
}

# When the configuration is going into ~/.zshrc, zsh has to exist for any of it
# to be read. Gated on SHELL_KIND rather than on the platform, so a box that
# logs you into bash no longer gets zsh installed for a file nothing reads.
ensure_zsh_present() {
  [ "$SHELL_KIND" = "zsh" ] || return 0
  command -v zsh >/dev/null 2>&1 && return 0
  [ "$OS_KIND" = "macos" ] && return 0
  info "Installing zsh so that $SHELL_RC is actually read."
  if package_available zsh && install_package zsh; then
    ok "zsh installed."
  else
    warn "Could not install zsh; $SHELL_RC will not be read until you do."
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Installation summary
# ---------------------------------------------------------------------------
print_summary() {
  local cmd status source path
  section "Installation summary"
  printf '%-12s %-8s %-16s %s\n' "TOOL" "STATUS" "SOURCE" "PATH"
  printf '%-12s %-8s %-16s %s\n' "----" "------" "------" "----"
  while IFS='|' read -r cmd status source path; do
    [ -n "$cmd" ] || continue
    printf '%-12s %-8s %-16s %s\n' "$cmd" "$status" "$source" "$path"
  done <<RESULTS_EOF
$RESULTS
RESULTS_EOF
  printf '\n'
  info "Successful: $COUNT_SUCCESS"
  info "Skipped by filter: $COUNT_SKIPPED"
  info "No build for this platform: $COUNT_ABSENT"
  info "Failed: $COUNT_FAILED"
}

# tool_succeeded — did this catalog entry end the run as a SUCCESS?
tool_succeeded() {
  printf '%s\n' "$RESULTS" | grep -q "^$1|SUCCESS|"
}

# report_preview_notes — installing the backends cannot make a terminal draw an
# image, for the same reason installing the font cannot select it: that decision
# belongs to the terminal, and for a remote box it belongs to the terminal on
# the user's own laptop. Say so rather than implying previews now just work.
report_preview_notes() {
  tool_succeeded yazi || return 0
  section "yazi image previews"
  info "yazi draws images with the Kitty graphics protocol, iTerm2 inline images"
  info "or sixel. All three are escape sequences, so they do travel over SSH — but"
  info "it is the terminal you are sitting in front of that has to support them,"
  info "not this machine. Ueberzug is the one adapter that cannot work remotely,"
  info "because it needs a local display to put its window on."
  info "See what was detected here with: yazi --debug"
  if command_works tmux; then
    info "Inside tmux, graphics need one line in ~/.tmux.conf:"
    printf '    set -g allow-passthrough on\n'
  fi
  info "Over SSH, TERM_PROGRAM is not forwarded by default; add it to ~/.ssh/config"
  info "with SetEnv if yazi reports no image adapter."
}

print_next_steps() {
  section "Next steps"
  info "Reload your shell configuration:"
  printf '    source %s\n' "$SHELL_RC"
  info "$SHELL_RC holds $SHELL_KIND syntax, so source it from $SHELL_KIND."
  info "Or just log out and back in."
  [ -n "$LOG_FILE" ] && info "Full log: $LOG_FILE"
}

# ---------------------------------------------------------------------------
# run_all — everything that belongs in the log, from environment detection to
# the summary. Returns the process exit code.
# ---------------------------------------------------------------------------
run_all() {
  trap 'printf "\n"; warn "Interrupted by user."; exit '"$EXIT_INTERRUPT" INT

  local rc
  printf 'nanolander %s — %s\n' "$NANOLANDER_VERSION" "$(date '+%Y-%m-%d %H:%M:%S')"

  detect_environment
  rc=$?
  [ "$rc" -eq 0 ] || return "$rc"

  ensure_sudo
  rc=$?
  [ "$rc" -eq 0 ] || return "$rc"

  setup_homebrew
  rc=$?
  [ "$rc" -eq 0 ] || return "$rc"

  refresh_package_index
  rc=$?
  [ "$rc" -eq 0 ] || return "$rc"

  ensure_zsh_present
  mkdir -p "$LOCAL_BIN" "$LOCAL_OPT"

  install_all_tools

  configure_shell
  [ "$OPT_CONFIGURE_GIT" -eq 1 ] && configure_git_pager
  [ "$OPT_SET_DEFAULT_SHELL" -eq 1 ] && set_default_shell
  [ "$OPT_WITH_NVIM_CONFIG" -eq 1 ] && install_nvim_config

  print_summary
  report_preview_notes

  if [ "$COUNT_FAILED" -gt 0 ]; then
    warn "$COUNT_FAILED tool(s) failed. Search the log for '== Installing <name> ==' to see why."
    print_next_steps
    return "$EXIT_PARTIAL"
  fi

  ok "All requested tools passed verification."
  print_next_steps
  return "$EXIT_OK"
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
main() {
  trap 'printf "\n"; warn "Interrupted by user."; exit '"$EXIT_INTERRUPT" INT

  parse_args "$@"
  local rc=$?
  if [ "$rc" -ne 0 ]; then
    exit "$rc"
  fi

  if [ "$DO_HELP" -eq 1 ]; then
    usage
    exit "$EXIT_OK"
  fi
  if [ "$DO_LIST" -eq 1 ]; then
    print_tool_catalog
    exit "$EXIT_OK"
  fi

  # ~/.local/bin has to be searchable now, not just after the next login,
  # otherwise command_works cannot see what we just installed.
  export PATH="$LOCAL_BIN:$PATH"

  if [ "$DO_RESTORE_SHELL" -eq 1 ]; then
    run_logged restore_shell
    exit $?
  fi
  if [ "$DO_UNINSTALL" -eq 1 ]; then
    run_logged uninstall_nanolander
    exit $?
  fi

  run_logged run_all
  exit $?
}

# run_logged — run one function with its output teed to the log file. The log
# is a byte-for-byte copy of the screen, which is why the output helpers emit
# plain text.
run_logged() {
  if : > "$LOG_FILE" 2>/dev/null; then
    "$1" 2>&1 | tee -a "$LOG_FILE"
    return "${PIPESTATUS[0]}"
  fi
  warn "Cannot write $LOG_FILE; continuing without a log file."
  LOG_FILE=""
  "$1"
}

# Sourcing this file with NANOLANDER_LIB=1 loads the functions without running
# anything, which is how the behaviour above can be exercised in isolation.
if [ "${NANOLANDER_LIB:-0}" != "1" ]; then
  main "$@"
fi
